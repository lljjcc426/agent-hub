{
  "name": "roppo-desktop",
  "productName": "Roppo",
  "version": "0.3.1",
  "private": true,
  "description": "The local Roppo workspace in a Mac window",
  "author": "Roppo",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test notifications/*.test.cjs update/*.test.cjs",
    "prepackage": "install-electron",
    "package": "electron-builder --mac dir --arm64",
    "release:local": "npm run package && python3 update/publish.py ../../.local/mac-desktop/mac-arm64/Roppo.app"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.roppo.studio.desktop",
    "asar": true,
    "files": [
      "main.cjs",
      "package.json",
      "update/feed.cjs",
      "notifications/activity.cjs",
      "notifications/monitor.cjs",
      "notifications/desktop.cjs"
    ],
    "directories": {
      "output": "../../.local/mac-desktop"
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "SUPublicEDKey": "jHnGPTKXj/bs18mAzg1h6SMU+wdVKXxGQaFpyeNLDCo=",
        "SUEnableAutomaticChecks": true,
        "SUScheduledCheckInterval": 21600,
        "SURequireSignedFeed": true,
        "SUVerifyUpdateBeforeExtraction": true,
        "SUAutomaticallyUpdate": false
      }
    },
    "npmRebuild": false,
    "afterPack": "update/pack.cjs",
    "electronDist": "node_modules/electron/dist"
  }
}
